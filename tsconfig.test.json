{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": ".test-dist",
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2019",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": false
  },
  "include": [
    "lib/**/*.ts",
    "hooks/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
